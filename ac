/usr/bin/timeout 10 /usr/bin/strace -f -o /tmp/dbx_strace.log /usr/local/bin/databricks version
echo "RC=$?"

tail -50 /tmp/dbx_strace.log
which timeout
which strace


databricks version > /tmp/dbx_version.txt 2>&1
echo "RC=$?"
cat /tmp/dbx_version.txt


databricks current-user me > /tmp/dbx_me.txt 2>&1
echo "RC=$?"
cat /tmp/dbx_me.txt


databricks account service-principals list > /tmp/dbx_sp.txt 2>&1
echo "RC=$?"
cat /tmp/dbx_sp.txt
